# ---------------------------------------------------------------------------
# n8n configuration template.
#
# Copy to .env and fill in, or just run ./scripts/bootstrap.sh which does the
# copying, generates the encryption key, and locks the file permissions for you:
#
#     cp .env.example .env && chmod 600 .env
#
# .env holds your encryption key. It must never be committed and must never be
# world-readable — anything that can read this file can decrypt every credential
# stored in n8n. .gitignore already excludes it; `chmod 600 .env` does the rest.
# ---------------------------------------------------------------------------


# --- Your domain ------------------------------------------------------------
# The only three lines most people need to change. Replace yourdomain.com
# with the domain you already have on Cloudflare.

N8N_HOST=n8n.yourdomain.com
WEBHOOK_URL=https://n8n.yourdomain.com/
N8N_EDITOR_BASE_URL=https://n8n.yourdomain.com/

# n8n only ever speaks plain HTTP on the loopback interface. The "https" here
# is about the URLs it *generates* — webhook addresses it shows you, OAuth
# callback URLs it registers with Google and friends. TLS is terminated by
# Cloudflare, before the traffic ever reaches your VPS.
N8N_PROTOCOL=https

# Sends the session cookie with the Secure flag, so a browser will refuse to
# transmit it over plain HTTP. Safe because everything real arrives over HTTPS.
N8N_SECURE_COOKIE=true


# --- The encryption key -----------------------------------------------------
# n8n encrypts every stored credential with this key. Two consequences worth
# understanding before you continue:
#
#   1. Lose it and your stored credentials are permanently unreadable. Not
#      "reset the password" unreadable — gone. Back it up somewhere off the VPS
#      (a password manager entry is ideal).
#   2. Change it after first start and n8n can no longer decrypt what it
#      already wrote. Set it once, before the very first `docker compose up`.
#
# Generate exactly 32 characters (192 bits of entropy, base64):
#
#     openssl rand -base64 24
#
# bootstrap.sh does this automatically if you leave the placeholder in place.
N8N_ENCRYPTION_KEY=REPLACE_ME_RUN_openssl_rand_base64_24


# --- Networking -------------------------------------------------------------

# Host-side port. Only cloudflared (running on this same machine) connects here.
N8N_PORT=5678

# Host-side interface. 127.0.0.1 means the port exists only on the VPS's own
# loopback — unreachable from the internet regardless of firewall state.
# Do not change this to 0.0.0.0 "just to test something"; that publishes an
# unauthenticated-until-you-log-in n8n straight onto the public internet.
N8N_BIND_ADDRESS=127.0.0.1

# NOTE — the address n8n binds to *inside the container* is pinned to 0.0.0.0
# in docker-compose.yml and is deliberately not configurable here. Inside the
# container that is a private, single-process network namespace, so 0.0.0.0
# exposes nothing; setting it to 127.0.0.1 instead would stop Docker's port
# publisher from reaching n8n and the service would never come up healthy.
# The loopback restriction that matters is N8N_BIND_ADDRESS above.


# --- Privacy and telemetry --------------------------------------------------

# No usage analytics off the box.
N8N_DIAGNOSTICS_ENABLED=false
N8N_DIAGNOSTICS_CONFIG_FRONTEND=
N8N_DIAGNOSTICS_CONFIG_BACKEND=

# No "a new version is available" call-home on every page load.
N8N_VERSION_NOTIFICATIONS_ENABLED=false

# The template gallery fetches from n8n's public API. Set to true if you want
# to browse prebuilt workflows in the editor.
N8N_TEMPLATES_ENABLED=false

N8N_HIRING_BANNER_ENABLED=false


# --- Hardening --------------------------------------------------------------

# Refuse to start if ~/.n8n/config (which contains the key material) is
# readable by anyone but its owner. Turns a silent permission mistake into a
# loud startup failure.
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# Stops Code nodes from reading process.env. Without this, anyone who can edit
# a workflow can print N8N_ENCRYPTION_KEY to the execution log in one line.
# This is the single highest-value toggle in this file.
N8N_BLOCK_ENV_ACCESS_IN_NODE=true

# Runs Code nodes in a separate task-runner process rather than in the main
# n8n process. Better isolation, and it silences a deprecation warning.
N8N_RUNNERS_ENABLED=true

# Community nodes are arbitrary third-party code running with n8n's privileges.
# Leave false unless you have a specific node you have actually vetted.
N8N_COMMUNITY_PACKAGES_ENABLED=false


# --- Free-tier housekeeping -------------------------------------------------
# A small VPS dies of a full disk long before it dies of load.

# Throw away execution history older than 7 days (168 hours), and never keep
# more than 5000 records regardless of age.
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=5000

# Write binary data (file attachments, downloads) to disk instead of holding it
# in RAM. On a 1 GB box, one 200 MB download otherwise takes the process out.
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# Reclaim SQLite free pages at startup, so a big prune actually returns disk.
DB_SQLITE_VACUUM_ON_STARTUP=true

# Largest accepted request body, in MB.
N8N_PAYLOAD_SIZE_MAX=16

N8N_LOG_LEVEL=info


# --- Resources --------------------------------------------------------------
# Hard ceiling enforced by Docker. Keep this comfortably below the box's total
# RAM so that sshd survives a runaway workflow and you don't get locked out.
N8N_MEMORY_LIMIT=768M

# Node's own heap ceiling. Keep it ~15% under N8N_MEMORY_LIMIT so Node hits a
# recoverable JS heap error before the kernel OOM-killer hits the container.
NODE_OPTIONS=--max-old-space-size=640


# --- Time -------------------------------------------------------------------
# Used for Cron/Schedule triggers. Get this wrong and everything fires at the
# wrong hour. Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
GENERIC_TIMEZONE=Africa/Johannesburg
TZ=Africa/Johannesburg


# --- Set by bootstrap.sh ----------------------------------------------------
# The exact image digest that was installed and tested. Leave it alone; use
# ./scripts/update.sh to move to a newer version deliberately.
#N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
