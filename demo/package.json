{
  "name": "ctf-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Cut Through Faster \u2014 personalised Hope demo pages for cold-email prospects",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "npm run build:worker && wrangler dev",
    "deploy": "npm run build:worker && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "@vapi-ai/web": "^2.5.0",
    "next": "^16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.131.1"
  }
}
