# Copy to `.env.local` for `npm run dev` (the Next dev server), and to
# `.dev.vars` for `npm run preview` (the built Worker under wrangler). Same
# names either way. Never commit either file — SUPABASE_SERVICE_ROLE_KEY is a
# full-database credential.
#
# In production these are Cloudflare Worker secrets:
#   wrangler secret put SUPABASE_URL
#   wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#   ...and so on for the rest.
#
# Note what is NOT here: no NEXT_PUBLIC_* variables and no Supabase anon key.
# The browser never talks to Supabase, so there is nothing to leak. The two
# Vapi values do reach the browser, but as props rendered by the server, which
# means rotating them is a `wrangler secret put` and a redeploy of the same
# build rather than a rebuild.

# --- Supabase -----------------------------------------------------------
# Project → Settings → Data API. Looks like https://abcdefgh.supabase.co
SUPABASE_URL=

# Project → Settings → API Keys → `service_role`. Bypasses row level security,
# which is exactly why it lives here and only here. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Vapi ---------------------------------------------------------------
# Vapi dashboard → API Keys → Public Key. Safe in the browser by design.
VAPI_PUBLIC_KEY=

# The one demo assistant. Its voice and transcriber serve every call. Its
# dashboard script (vapi/assistant.md) is used only by dental prospects' own
# links; every other call sends Hope's script for its industry instead
# (src/lib/hope.ts, vapi/hope-prompt.md). Never an assistant per practice.
VAPI_ASSISTANT_ID=

# --- Booking ------------------------------------------------------------
# Where "Book a 15-minute call" points. Calendly, Cal.com, SavvyCal, anything
# with a URL.
BOOKING_URL=https://calendly.com/cutthroughfaster/15min

# --- Limits -------------------------------------------------------------
# Any long random string. Salts the hash of a caller's IP, which is all the
# public line's per-person limit and the callback form's flood limit store.
# Optional: without it those per-person limits are skipped and only the daily
# caps apply.
DEMO_IP_SALT=

# --- Callback emails ----------------------------------------------------
# Each callback request from the marketing site is emailed through Resend,
# as the dashboard sends its email. Without EMAIL_API_KEY requests are still
# saved to `leads`, and nobody is emailed.
EMAIL_API_KEY=
# Where the email goes. Defaults to hello@cutthroughfaster.com.
LEAD_NOTIFY_TO=
# Optional sender; must be on a domain verified with Resend. Defaults to
# "CTF website <website@mail.cutthroughfaster.com>".
EMAIL_FROM=
