{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ctf-demo",

  // Built by `opennextjs-cloudflare build`, which compiles the Next server into
  // a Worker and emits the static assets beside it. Neither path is committed.
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "compatibility_date": "2026-09-01",
  // Required by the adapter: the Next server expects Node built-ins.
  "compatibility_flags": ["nodejs_compat"],

  // Also serve on ctf-demo.<account>.workers.dev, so there is a working URL
  // before DNS is attached.
  "workers_dev": true,

  // The address that goes in the cold email. Wrangler creates the DNS record
  // and certificate on deploy, because cutthroughfaster.com is already a zone
  // in this Cloudflare account.
  //
  // This is a NEW, separately named Worker. It has nothing to do with the
  // `ctf-website` or `throbbing-disk-fd8d` builds wired to the marketing site,
  // and deploying it does not touch them.
  "routes": [
    {
      "pattern": "demo.cutthroughfaster.com",
      "custom_domain": true
    }
  ],

  "observability": { "enabled": true },

  // Per-visitor flood limits, per minute, keyed on the hashed IP (src/lib/
  // limits.ts). Far above what a person does — one visit is a page load, a
  // gate check and three or four events — and far below a script. Counted at
  // the edge, so a flood costs no database work. The namespace ids only have
  // to be unique within the Cloudflare account.
  "ratelimits": [
    // Demo page loads, the prospect lookup and the public line's gate.
    { "name": "DEMO_READ_LIMITER", "namespace_id": "7101", "simple": { "limit": 30, "period": 60 } },
    // Call tracking: page_view, call_started, call_ended.
    { "name": "DEMO_EVENT_LIMITER", "namespace_id": "7102", "simple": { "limit": 30, "period": 60 } },
    // The marketing site's callback form.
    { "name": "LEAD_FORM_LIMITER", "namespace_id": "7103", "simple": { "limit": 5, "period": 60 } }
  ]

  // Secrets — set with `wrangler secret put <NAME>`, never in this file:
  //   SUPABASE_URL
  //   SUPABASE_SERVICE_ROLE_KEY   bypasses RLS; server-side only
  //   VAPI_PUBLIC_KEY
  //   VAPI_ASSISTANT_ID
  //   VAPI_LAW_ASSISTANT_ID       optional; law firms' links are a 404 until it is set
  //   BOOKING_URL
  //   DEMO_IP_SALT                salts the caller-IP hash the limits count
  //   EMAIL_API_KEY               Resend key; emails each callback request
  //   LEAD_NOTIFY_TO              the inbox those emails go to
}
