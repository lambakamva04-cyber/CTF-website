# Copy to `.dev.vars` for `npm run preview` (the Worker running under wrangler).
# `next dev` reads `.env.local` instead — same five names, same values.
# Never commit either file: SUPABASE_SERVICE_ROLE_KEY is a full-database credential.
#
# In production these are set with `wrangler secret put <NAME>`.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
BOOKING_URL=
